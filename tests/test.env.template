# Live-test environment for tests/Invoke-BookTests.ps1 -Live
#
# Copy this file to tests/test.env (git-ignored) and fill it in. Anything still
# in <angle brackets> counts as unset.
#
# The live tier builds a SEPARATE copy of the book's environment with the
# book's own names, runs every chapter's examples against it, and deletes it
# afterwards. Use a subscription that does NOT hold your real Collier Health
# environment: the resource group name is the book's, so the suite refuses to
# touch a group that it did not tag itself (booktest=true).
#
# Never commit tests/test.env. It holds a SQL admin password.

# ---- Subscription and location ----------------------------------------------
SUBSCRIPTION_ID=<subscription-id-for-test-runs>
LOC=<region, for example westus3>

# ---- Book names (keep these unless your subscription forces otherwise) -------
RG=rg-collierhealth
# Logical server names are globally unique: book name plus your own suffix.
SRV=collierhealth-<unique-suffix>
DB=wardgeneral

# ---- Chapter 2: server administrators ---------------------------------------
# Entra admin: the object ID of the user or group running the tests. The tester
# must be able to sign in to the database with sqlcmd -G (Entra auth).
ADMIN_OBJECT_ID=<entra-object-id>
ADMIN_TYPE=User
ADMIN_DISPLAY_NAME=<entra-display-name-or-upn>
SQL_ADMIN_USER=wardadmin
SQL_ADMIN_PASSWORD=<strong-password-for-the-mixed-auth-admin>

# ---- Chapter 5: Azure AI ------------------------------------------------------
# Foundry (Azure OpenAI) account name: globally unique.
AI_RESOURCE=<unique-foundry-name>
# Optional: AI_LOCATION and GATEWAY_LOCATION default to the server's region.
AI_LOCATION=<optional-region>
GATEWAY_LOCATION=<optional-region>
PUBLISHER_EMAIL=<email-for-api-management>
# Optional overrides; the scripts derive <AI_RESOURCE>-gateway and
# <AI_RESOURCE>-contentsafety otherwise.
APIM_NAME=<optional-apim-name>
CS_RESOURCE=<optional-content-safety-name>

# ---- Chapter 8: TDE with a customer-managed key ------------------------------
# Key Vault names are globally unique and, with purge protection, stay reserved
# after deletion. The suite appends a short per-run suffix to this prefix.
TDE_VAULT_PREFIX=<short-prefix, for example kvcollier>

# ---- Chapter 9: geo-replica ------------------------------------------------------
# Target logical server name (globally unique). Leave GEO_LOCATION unset to use
# the source region's Azure paired region, as the book does.
GEO_SERVER=<unique-geo-server-name>
GEO_LOCATION=<optional-region>

# ---- Chapter 10: sqlsim (Windows only) ----------------------------------------
# Full path to sqlsim.exe from https://aka.ms/sqlsimtools.
SQLSIM=<C:\path\to\sqlsim.exe>

# ---- Suite options -----------------------------------------------------------------
# Notes to embed in Chapter 5 (06-ai-embeddings.sql). 0 embeds the whole corpus
# as the book does (3-4 hours of metered model calls).
BOOKTEST_EMBEDDING_LIMIT=2000
# Chapter 10 Demo 2 workload length per interval, in seconds (book: 300).
BOOKTEST_GROWTH_SECONDS=300
